<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" spacing="10.0" style="-fx-background-color: #F7FDFF;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label style="-fx-text-fill: #00B6D4;" text="Connexion">
         <font>
            <Font size="26.0" />
         </font></Label>
        <GridPane alignment="CENTER" hgap="10.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" maxWidth="264.0" minWidth="10.0" prefWidth="125.0" />
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="428.0" minWidth="10.0" prefWidth="415.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Label alignment="TOP_RIGHT" text="Nom*" GridPane.halignment="LEFT" />
                <TextField fx:id="loginConnexion" onKeyTyped="#actualiseInfoConnexion" promptText="Nom" GridPane.columnIndex="1" />
                <Label layoutX="10.0" layoutY="16.0" text="Mot de passe*" GridPane.halignment="LEFT" GridPane.rowIndex="1" />
                <PasswordField fx:id="passwordConnexion" onKeyTyped="#actualiseInfoConnexion" promptText="Mot de passe" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            </children>
        </GridPane>
        <Label fx:id="infoLabelConnexion" text="Tous les champs sont obligatoires." />

        <Button fx:id="seConnecterButton" mnemonicParsing="false" onAction="#onConnexion" style="-fx-background-color: #00B6D4; -fx-text-fill: white; -fx-background-radius: 5;" text="Se connecter" />

        <Button fx:id="createAccountButton" mnemonicParsing="false" onAction="#onCreateAccount" style="-fx-background-color: #00B6D4; -fx-text-fill: white; -fx-background-radius: 5;" text="Créer un compte" />
        <ImageView fitWidth="160.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@Picture/LowRes_Gèr-TaCaisse.png" />
            </image>
        </ImageView>
    </children>
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
</VBox>
