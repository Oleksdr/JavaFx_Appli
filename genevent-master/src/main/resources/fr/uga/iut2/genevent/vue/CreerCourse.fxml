<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="650.0" prefWidth="1050.0" style="-fx-background-color: #FFFFFF; -fx-font-family: 'Segoe UI', Helvetica, Arial, sans-serif;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
    <children>

        <HBox alignment="CENTER_LEFT" prefHeight="80.0" prefWidth="200.0" spacing="15.0" style="-fx-background-color: #fdebf0;">
            <children>
                <ImageView fitHeight="65.0" fitWidth="85.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@Picture/LowRes_Gèr-TaCaisse.png" />
                    </image>
                </ImageView>
                  <Label style="-fx-text-fill: #00B6D4; -fx-font-weight: bold;" text="Édition de la course">
                      <font>
                          <Font size="26.0" />
                      </font>
                  </Label>
                <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#onAccueilButtonPageCourse" style="-fx-background-color: null; -fx-padding: 0;">
               <graphic>
                      <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" style="-fx-cursor: hand;">
                     <image>
                        <Image url="@Picture/home.png" />
                     </image></ImageView>
               </graphic>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
            </children>
         <padding>
            <Insets bottom="15.0" left="40.0" right="40.0" top="15.0" />
         </padding>
        </HBox>

        <HBox prefHeight="100.0" prefWidth="200.0" spacing="60.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="10.0" left="50.0" right="50.0" top="20.0" />
            </padding>
            <children>

                <VBox alignment="TOP_LEFT" prefHeight="400.0" spacing="25.0" HBox.hgrow="ALWAYS">
                    <children>
                        <GridPane vgap="15.0" VBox.vgrow="ALWAYS">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" maxWidth="200.0" minWidth="10.0" prefWidth="160.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="240.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" prefHeight="45.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="45.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="45.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="45.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="100.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="100.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <Label fx:id="labelNomCourse" style="-fx-font-size: 15px; -fx-text-fill: #2C3E50; -fx-font-weight: bold;" text="Nom de la course*" />
                                <Label fx:id="labelDateDebut" style="-fx-font-size: 15px; -fx-text-fill: #2C3E50; -fx-font-weight: bold;" text="Date de début*" GridPane.rowIndex="1" />
                                <Label fx:id="labelDateFin" style="-fx-font-size: 15px; -fx-text-fill: #2C3E50; -fx-font-weight: bold;" text="Date de fin*" GridPane.rowIndex="2" />
                                <Label style="-fx-font-size: 15px; -fx-text-fill: #2C3E50; -fx-font-weight: bold;" text="Lieu de la course" GridPane.rowIndex="3" />
                                <Label style="-fx-font-size: 15px; -fx-text-fill: #2C3E50; -fx-font-weight: bold;" text="Description" GridPane.rowIndex="4" />

                                <TextField fx:id="nomCourseField" onKeyTyped="#actualiseConditionNomCreerCourse" promptText="ex : Course de l'année" style="-fx-border-color: #0bc5e3; -fx-border-radius: 5;" GridPane.columnIndex="1">
                                    <font><Font size="14.0" /></font></TextField>
                        <DatePicker fx:id="dateDebutPicker" editable="false" onAction="#actualiseLabelDates" prefHeight="35.0" prefWidth="300.0" promptText="JJ / MM / AAAA" style="-fx-border-color: #0bc5e3; -fx-border-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <DatePicker fx:id="dateFinPicker" editable="false" onAction="#actualiseLabelDates" prefHeight="35.0" prefWidth="300.0" promptText="JJ / MM / AAAA" style="-fx-border-color: #0bc5e3; -fx-border-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                <TextField fx:id="lieuCourseField" promptText="ex : Grenoble" style="-fx-border-color: #0bc5e3; -fx-border-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                    <font><Font size="14.0" /></font></TextField>
                                <TextArea fx:id="descriptionCourseArea" prefHeight="120.0" prefWidth="200.0" promptText="Description de la course" style="-fx-border-color: #0bc5e3; -fx-border-radius: 5;" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="4">
                                    <font><Font size="14.0" /></font></TextArea>
                        <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="20.0" GridPane.columnIndex="1" GridPane.rowIndex="5">
                           <children>
                              <Label fx:id="labelCoutsCourse" style="-fx-font-size: 15px; -fx-text-fill: #2C3E50; -fx-font-weight: bold;" text="Coûts" />
                              <Spinner fx:id="coutsFieldCourse" editable="true" prefWidth="100.0" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="20.0" GridPane.rowIndex="5">
                           <children>
                              <Label fx:id="labelRevenusCourse" style="-fx-font-size: 15px; -fx-text-fill: #2C3E50; -fx-font-weight: bold;" text="Revenu" />
                              <Spinner fx:id="revenusFieldCourse" editable="true" prefWidth="100.0" />
                           </children>
                        </HBox>
                            </children>
                        </GridPane>

                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Label alignment="CENTER" prefHeight="20.0" prefWidth="20.0" style="-fx-background-color: #00B6D4; -fx-background-radius: 20; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-style: italic; -fx-font-size: 11px;" text="i" />
                                <Label style="-fx-text-fill: #555555; -fx-font-size: 13px;" text="Les champs notés avec * sont obligatoires." />
                            </children>
                            <VBox.margin>
                                <Insets bottom="10.0" />
                            </VBox.margin>
                        </HBox>
                    </children>
                </VBox>

                <VBox alignment="TOP_LEFT" prefHeight="200.0" prefWidth="420.0" spacing="15.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label style="-fx-font-size: 24px; -fx-text-fill: #7F8C8D; -fx-font-weight: bold;" text="+" />
                                <Label style="-fx-font-size: 22px; -fx-text-fill: #2C3E50; -fx-font-weight: bold;" text="Ajouter des équipes" />
                            </children>
                        </HBox>

                        <VBox spacing="15.0" style="-fx-background-color: #F7FDFF; -fx-border-color: #0bc5e3; -fx-border-width: 1.5; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 20;" VBox.vgrow="ALWAYS">
                            <children>
                                <TextField fx:id="chercherEquipeField" onKeyTyped="#chercherEquipePageCourse" promptText="Rechercher" style="-fx-background-color: #FFFFFF; -fx-border-color: #BDC3C7; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 8;">
                                    <font><Font size="14.0" /></font>
                                </TextField>
                        <VBox fx:id="listeEquipePageCourse" prefHeight="200.0" prefWidth="100.0" VBox.vgrow="ALWAYS" />

                                <HBox alignment="CENTER_RIGHT">
                                    <children>
                                        <Button fx:id="creerEquipeButtonPageCourse" mnemonicParsing="false" onAction="#onCreerEquipePageCourse" style="-fx-background-color: #00B6D4; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 10 20 10 20; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" text="Créer une équipe" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </HBox>

        <HBox alignment="CENTER" prefHeight="80.0">
            <children>
                <Button fx:id="sauvegarderCourse" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#onSauvegarderCourse" style="-fx-background-color: #00B6D4; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 12 35 12 35; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand;" text="Sauvegarder" />
            </children>
        </HBox>
    </children>
</VBox>
