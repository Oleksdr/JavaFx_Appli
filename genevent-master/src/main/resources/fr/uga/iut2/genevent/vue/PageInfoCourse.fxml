                        <TableView fx:id="tableauEquipeInfoCourse" prefHeight="200.0" style="-fx-background-color: #F7FDFF; -fx-border-color: #0bc5e3; -fx-border-width: 1.5; -fx-border-radius: 4;" VBox.vgrow="ALWAYS">
                            <columns>
