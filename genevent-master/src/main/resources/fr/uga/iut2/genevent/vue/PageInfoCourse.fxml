                                </TextField>
                                <TextField fx:id="localisationFieldInfoCourse" editable="false" focusTraversable="false" promptText="ex : Grenoble" style="-fx-border-color: #0bc5e3; -fx-border-radius: 5; -fx-background-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <font><Font size="14.0" /></font>
                           <padding>
