                           <font>
                              <Font size="15.0" />
                           </font></Label>
                                <TextArea fx:id="descriptionAreaInfoCourse" editable="false" focusTraversable="false" prefHeight="130.0" promptText="Description de l'équipe" style="-fx-border-color: #0bc5e3; -fx-border-radius: 5; -fx-background-radius: 5;" wrapText="true">
