                                <TextField fx:id="nomCourseFieldInfoCourse" editable="false" focusTraversable="false" promptText="ex : Course de l'année" style="-fx-border-color: #0bc5e3; -fx-border-radius: 5; -fx-background-radius: 5;" GridPane.rowIndex="1">
