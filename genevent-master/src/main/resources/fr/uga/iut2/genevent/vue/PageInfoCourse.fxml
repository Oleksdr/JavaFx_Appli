          <Button mnemonicParsing="false" onAction="#onRetourPageInfoCourse" prefHeight="52.0" prefWidth="135.0" style="-fx-background-color: #00B6D4; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 10 40 10 40; -fx-font-size: 15px;" text="Retour">
